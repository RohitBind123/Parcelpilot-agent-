# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# Streamlit
.streamlit/secrets.toml

# Logs
logs/*
!logs/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Notes:
#   data/index/ and data/parcelpilot.db are COMMITTED on purpose (see ARCHITECTURE.md D10)
#   so the hosted app never embeds or parses at runtime.

# CalQuity-supplied hiring material — keep local, do not publish
project_docs/*.docx

# Derived cache, never committed (see src/providers/cache.py)
data/embedding_cache.db*

# LangGraph checkpointer: runtime conversation state, written by every run
# (see src/agent/context.py DEFAULT_CHECKPOINT_PATH). Never committed.
data/threads.db*

# Runtime state: sessions, the action log, run events
# (see src/datastore/runtime.py). Never committed.
data/runtime.db*
