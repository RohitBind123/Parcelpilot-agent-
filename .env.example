# ParcelPilot AI Support System — environment template.
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The only value you MUST supply for a working local run is GEMINI_API_KEY
# (plus CHROMA_API_KEY, or set VECTOR_STORE=chroma_local to stay offline).
# Everything else has a verified default. See docs/ARCHITECTURE.md §15.

# --- Provider selection (D9a) ---------------------------------------------
# Gemini carries dev, tests and the demo. OpenRouter is fully implemented and
# switchable, but its account is deliberately unfunded and its ":free" slugs
# are being delisted, so it is not on the demo path.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# --- Gemini ----------------------------------------------------------------
# Both providers speak the OpenAI wire format, which is why swapping them
# costs three settings rather than an abstraction layer.
GEMINI_API_KEY=
# Slugs live here, never in code: gemini-2.5-flash began returning 404 for new
# accounts and an OpenRouter :free slug was delisted, both in one afternoon.
# Defaults below were verified on 2026-08-22.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite
# GEMINI_MODEL_STRONG=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIM=1536

# --- OpenRouter (alternate; only needed if you select it) ------------------
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL_CHEAP=google/gemini-2.5-flash-lite
# OPENROUTER_MODEL_STRONG=google/gemini-2.5-flash
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_EMBEDDING_DIM=1536

# --- Vector store (D20) ----------------------------------------------------
# chroma_cloud for dev and prod; chroma_local for tests, eval and offline work.
# The collection is namespaced by {provider}/{model}/{dim}, so switching
# embedding provider selects a different collection instead of silently
# comparing vectors that were never in the same space.
VECTOR_STORE=chroma_cloud
CHROMA_API_KEY=
# CHROMA_TENANT=          # from GET /api/v2/auth/identity; scripts/provision_chroma.py --check prints it
# CHROMA_DATABASE=parcelpilot
# CHROMA_PERSIST_DIR=data/index

# --- Structured store ------------------------------------------------------
# SQLITE_PATH=data/parcelpilot.db
# Sessions, the action log and run events. A separate file on purpose:
# SQLITE_PATH is committed, opened read-only, and rebuilt rather than migrated.
# RUNTIME_PATH=data/runtime.db

# --- Clock (D6: frozen AS_OF; there is no wall-clock fallback) -------------
# Read from the workbook README sheet by the ETL. Note it is a SUNDAY, which
# gates every business-hours SLA target in the pack.
AS_OF="2026-08-16 11:00 Asia/Kolkata"

# --- Runtime ---------------------------------------------------------------
# API_BASE_URL=http://127.0.0.1:8000
# Leave SESSION_SECRET unset and a random one is generated per process.
# Sessions then do not survive a restart, which is the right trade for a
# mocked login. A shipped default would be a forgeable token.
# SESSION_SECRET=
# LOG_LEVEL=INFO
# REPAIR_BUDGET=2
# REQUEST_TIMEOUT_SECONDS=30
