# ParcelPilot AI Support System — environment template
# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Model provider (required) --------------------------------------------
# One OpenRouter key serves chat + embeddings via the OpenAI-compatible API.
# Fund the account with $10 once: the unfunded cap is 50 requests/day, and a
# single agent turn costs 4-6 calls. See ARCHITECTURE.md §14.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Model slugs (pinned; free ":free" endpoints get delisted without notice)
# Cheap tier: classification, query rewrite, routing.
MODEL_CHEAP=
# Strong tier: precedence explanation, final synthesis - where wrongness is expensive.
MODEL_STRONG=
# Fallback used when the primary slug returns 404/429.
MODEL_FALLBACK=

# --- Embeddings (build time only) -----------------------------------------
# Changing this silently invalidates the committed Chroma index (D10).
EMBEDDING_MODEL=
EMBEDDING_DIM=

# --- Optional: alternate providers ----------------------------------------
# Only needed if embeddings are moved off OpenRouter.
GEMINI_API_KEY=

# --- Storage --------------------------------------------------------------
# Local file-backed Chroma (default). Set CHROMA_API_KEY only if you switch
# to Chroma Cloud - the committed-index decision (D10) assumes local.
CHROMA_PERSIST_DIR=data/index
CHROMA_API_KEY=
SQLITE_PATH=data/parcelpilot.db

# --- Clock (D6: frozen AS_OF; never datetime.now()) -----------------------
# Read from the workbook README sheet at build time. Leave blank to force the
# ETL to populate it; a wall-clock fallback is deliberately NOT provided.
AS_OF=

# --- Runtime --------------------------------------------------------------
LOG_LEVEL=INFO
REPAIR_BUDGET=2
